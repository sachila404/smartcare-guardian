rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /children/{childId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.guardians;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.guardians;

      match /vitalsLive/{doc} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.guardians;
        allow write: if false;
      }
      match /vitalsHistory/{doc} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.guardians;
        allow write: if false;
      }
    }

    match /alerts/{alertId} {
      allow read, update: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/children/$(resource.data.childId)).data.guardians;
      allow create: if false;
    }
    match /medications/{medId} {
      allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/children/$(resource.data.childId)).data.guardians;
    }
    match /careNotes/{noteId} {
      allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/children/$(request.resource.data.childId)).data.guardians;
    }
  }
}